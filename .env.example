# CoplinTech · Variables públicas del frontend (Vite)
# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# Solo URL + clave publicable/anon. NUNCA pongas aquí la clave service_role ni claves secretas (sb_secret_...).

VITE_SUPABASE_URL=
# Clave publicable (sb_publishable_...) — recomendada en proyectos nuevos de Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa: clave anon (JWT) heredada. Se usa solo si la publicable está vacía.
VITE_SUPABASE_ANON_KEY=
